{
  "name": "ponta-ping",
  "version": "1.0.0",
  "description": "API エンドポイントのヘルスチェックツール",
  "author": "Mr-Pontaman",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-Pontaman/electron-api-health-check"
  },
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --config electron-builder.config.ts",
    "build:linux": "npm run build && electron-builder --linux --config electron-builder.config.ts",
    "build:snap": "npm run build:unpack && snapcraft --destructive-mode",
    "build:win": "npm run build && electron-builder --win --config electron-builder.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.4.2",
    "better-sqlite3": "^12.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "prisma": "^7.4.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "zustand": "^5.0.14"
  }
}
